# Supabase public application configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anonymous-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Cloudflare R2 server-only S3 configuration
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=studydock-resources
UPLOAD_MAX_BYTES=104857600
REQUIRE_VERIFIED_EMAIL_FOR_UPLOAD=true
RATE_LIMIT_HASH_SECRET=generate-a-long-random-server-only-value

# Optional server-only AI configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-approved-model
CRON_SECRET=generate-a-long-random-server-only-value
AI_MAX_SOURCE_BYTES=15728640
SUPABASE_LEGACY_RESOURCE_BUCKET=
ACCOUNT_ERASURE_ENABLED=false

# Operator-only: applying migrations (scripts/apply-migrations.mjs).
# Supabase Dashboard > Project Settings > Database > Connection string > URI.
# Percent-encode reserved characters in the password, and drop the [ ] that the
# dashboard prints around the placeholder.
SUPABASE_DB_URL=

# Operator-only: development seed accounts (scripts/seed-dev-data.mjs).
# Leave blank to generate a strong random password and print it once.
# Never commit real values here.
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
