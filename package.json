{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:seed": "node scripts/seed-dev-data.mjs",
    "db:reset-users": "node scripts/seed-dev-data.mjs --reset-users",
    "verify:r2": "node scripts/verify-r2.mjs"
  },
